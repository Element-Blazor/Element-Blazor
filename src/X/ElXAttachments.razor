@inherits ElementComponentBase

<div class="@AttachmentsClass" style="@Style" @attributes="Attributes">
    @if (!Readonly)
    {
        <ElUpload Url="@UploadUrl"
                  AutoUpload="@AutoUpload"
                  Multiple="@Multiple"
                  Limit="@Limit"
                  Accept="@Accept"
                  Drag="@Drag"
                  ShowFileList="false"
                  AllowExtensions="@AllowExtensions"
                  MaxSize="@MaxSize"
                  Disabled="@Disabled"
                  BeforeUpload="@BeforeUpload"
                  BeforeRemove="@BeforeRemove"
                  HttpRequest="@HttpRequest"
                  OnChange="HandleUploadChangeAsync"
                  OnProgress="HandleUploadProgressAsync"
                  OnSuccess="HandleUploadSuccessAsync"
                  OnError="HandleUploadErrorAsync"
                  OnExceed="HandleUploadExceedAsync">
            <ChildContent>
                @if (UploadContent != null)
                {
                    @UploadContent
                }
                else
                {
                    <ElButton Type="@ButtonType.Primary" Plain="true" Icon="el-icon-paperclip">Attach</ElButton>
                }
            </ChildContent>
        </ElUpload>
    }
    @if (Items != null && Items.Any())
    {
        <div class="el-x-attachments__list">
            @foreach (var item in Items)
            {
                @if (ItemTemplate != null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    <ElXFilesCard File="@item"
                                  Readonly="@Readonly"
                                  OnRemove="RemoveAsync"
                                  OnPreview="PreviewAsync" />
                }
            }
        </div>
    }
    else if (EmptyContent != null)
    {
        <div class="el-x-attachments__empty">@EmptyContent</div>
    }
</div>
