@inherits ElementComponentBase

<section class="@MentionSenderClass" style="@Style" @attributes="Attributes">
    <ElMention Value="@Value"
               ValueChanged="OnValueChangedAsync"
               Options="@Options"
               Prefixes="@Prefixes"
               Prefix="@Prefix"
               ItemTemplate="@ItemTemplate"
               Placeholder="@Placeholder"
               Rows="@Rows"
               Disabled="@Disabled"
               Readonly="@Readonly"
               Clearable="@Clearable"
               Autocomplete="@Autocomplete"
               Tabindex="@Tabindex"
               Id="@Id"
               Name="@Name"
               InputStyle="@InputStyle"
               AriaLabel="@AriaLabel"
               AriaDescribedby="@EffectiveAriaDescribedBy"
               OnSelect="HandleMentionSelectAsync"
               OnKeyDown="OnMentionKeyDownAsync">
    </ElMention>
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p class="el-x-mention-sender__help" id="@HelpId">@HelpText</p>
    }
    <div class="el-x-mention-sender__actions">
        @if (Toolbar != null)
        {
            <div class="el-x-mention-sender__tools">@Toolbar</div>
        }
        @if (ShowClearButton)
        {
            <ElButton Type="@ButtonType.Info"
                      Text="true"
                      Icon="@ClearButtonIcon"
                      Disabled="@IsClearDisabled"
                      OnClick="ClearAsync"
                      aria-label="@ClearButtonText">@ClearButtonText</ElButton>
        }
        @if (Loading && OnStop.HasDelegate)
        {
            <ElButton Type="@ButtonType.Danger"
                      Plain="true"
                      Icon="@StopButtonIcon"
                      OnClick="StopAsync"
                      aria-label="@StopButtonText">@StopButtonText</ElButton>
        }
        <ElButton Type="@ButtonType.Primary"
                  Loading="@Loading"
                  Icon="@SendButtonIcon"
                  Disabled="@IsSendDisabled"
                  OnClick="SendAsync"
                  aria-label="@SendButtonText">@SendButtonText</ElButton>
    </div>
</section>
