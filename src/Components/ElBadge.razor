@inherits ElementComponentBase
<div class="@BadgeClass" style="@Style" @attributes="Attributes">
    <CascadingValue Value="this">
        @ChildContent
        @if (!Hidden)
        {
            <sup class="@ContentClass" style="@ContentStyle">
                @if (!IsDot)
                {
                    @DisplayValue
                }
            </sup>
        }
    </CascadingValue>
</div>
