@inherits ElementFieldComponentBase<IList<string>>

<div class="@wrapperClsBuilder.ToString()"
     style="@Style"
     @onclick="FocusInputAsync">
    @foreach (var tag in CurrentTags)
    {
        <span class="el-tag el-tag--info el-tag--small el-tag--light" @key="tag">
            <span class="el-select__tags-text">@tag</span>
            @if (!IsInputTagDisabled && !Readonly)
            {
                <i class="el-tag__close el-icon-close" @onclick="e => RemoveTagAsync(tag)" @onclick:stopPropagation></i>
            }
        </span>
    }
    @if (!IsLimitReached)
    {
        <input class="el-input-tag__inner"
               @ref="inputElement"
               value="@inputText"
               placeholder="@EffectivePlaceholder"
               disabled="@IsInputTagDisabled"
               readonly="@Readonly"
               @oninput="OnInputAsync"
               @onkeydown="OnKeyDownAsync"
               @onblur="OnBlurAsync" />
    }
</div>
