@inherits ElementFieldComponentBase<IList<string>>

<div class="@wrapperClsBuilder.ToString()"
     style="@Style"
     @ref="cascaderElement"
     role="combobox"
     aria-haspopup="listbox"
     aria-expanded="@IsDropDownOpen"
     aria-disabled="@IsCascaderDisabled"
     aria-controls="@DropDownId"
     @onclick="OnCascaderClickAsync">
    <ElInput TValue="string"
             Value="@InputValue"
             ValueChanged="OnInputValueChangedAsync"
             Placeholder="@Placeholder"
             Disabled="@IsCascaderDisabled"
             Readonly="@(!Filterable)"
             Clearable="@Clearable"
             Size="@EffectiveSize"
             PrefixIcon="@PrefixIcon"
             SuffixIcon="@SuffixIconClass"
             ValidateEvent="false"
             OnClear="OnInputClearAsync"
             OnFocus="OnInputFocusAsync"
             OnBlur="OnInputBlurAsync">
    </ElInput>
</div>
