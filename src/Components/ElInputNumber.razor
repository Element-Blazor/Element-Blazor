@inherits ElementFieldComponentBase<decimal?>

<div class="@wrapperClsBuilder.ToString()" style="@Style" role="spinbutton" aria-valuemin="@Min" aria-valuemax="@Max" aria-valuenow="@Value" aria-disabled="@IsInputNumberDisabled">
    @if (Controls && ControlsPosition != "right")
    {
        <span class="@DecreaseButtonClass" role="button" aria-label="decrease" @onclick="DecreaseAsync">
            <i class="el-icon-minus"></i>
        </span>
        <span class="@IncreaseButtonClass" role="button" aria-label="increase" @onclick="IncreaseAsync">
            <i class="el-icon-plus"></i>
        </span>
    }
    <div class="el-input">
        <input class="el-input__inner"
               type="number"
               value="@FormattedValue"
               placeholder="@Placeholder"
               disabled="@IsInputNumberDisabled"
               readonly="@Readonly"
               min="@Min"
               max="@Max"
               step="@Step"
               @oninput="OnInputAsync"
               @onchange="OnChangeAsync"
               @onfocus="OnFocusAsync"
               @onblur="OnBlurAsync"
               @onkeydown="OnKeyDownAsync" />
    </div>
    @if (Controls && ControlsPosition == "right")
    {
        <span class="@IncreaseButtonClass" role="button" aria-label="increase" @onclick="IncreaseAsync">
            <i class="el-icon-arrow-up"></i>
        </span>
        <span class="@DecreaseButtonClass" role="button" aria-label="decrease" @onclick="DecreaseAsync">
            <i class="el-icon-arrow-down"></i>
        </span>
    }
</div>
