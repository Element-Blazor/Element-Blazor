@inherits ElCheckbox<TValue>
@typeparam TValue
@{ 
    switch (Status)
    {
        case Status.UnChecked:
            _isChecked = string.Empty;
            _isIndeterminate = string.Empty;
            break;
        case Status.Checked:
            _isChecked = "is-checked";
            _isIndeterminate = string.Empty;
            break;
        case Status.Indeterminate:
            _isChecked = string.Empty;
            _isIndeterminate = "is-indeterminate";
            break;
    }
    if (EffectiveDisabled)
    {
        isDisabled = "is-disabled";
    }
    var ariaChecked = Status == Status.Indeterminate ? "mixed" : (Status == Status.Checked).ToString().ToLowerInvariant();
    var isChecked = Status == Status.Checked;
    var buttonSizeClass = SizeClass.Replace("el-checkbox--", "el-checkbox-button--");
}
<label role="checkbox" aria-checked="@ariaChecked" aria-disabled="@EffectiveDisabled" class="el-checkbox-button @_isChecked @_isIndeterminate @isDisabled @buttonSizeClass">
    <input type="checkbox" class="el-checkbox-button__original @isDisabled" checked="@isChecked" disabled="@EffectiveDisabled" @onchange="ChangeStatus" />
    <span class="el-checkbox-button__inner">@ChildContent</span>
</label>
