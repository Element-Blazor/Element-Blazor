@inherits ElementComponentBase

@if (Loading)
{
    <div class="@WrapperClass" style="@WrapperStyle" @attributes="Attributes">
        @ChildContent
        <div class="@MaskClass" style="@MaskStyle" role="status" aria-live="polite">
            <div class="el-loading-spinner">
                @if (Spinner != null)
                {
                    @Spinner
                }
                else if (string.IsNullOrWhiteSpace(IconClass))
                {
                    <svg viewBox="25 25 50 50" class="circular">
                        <circle cx="50" cy="50" r="20" fill="none" class="path"></circle>
                    </svg>
                }
                else
                {
                    <i class="@IconClass"></i>
                }
                @if (!string.IsNullOrWhiteSpace(Text))
                {
                    <p class="el-loading-text">@Text</p>
                }
            </div>
        </div>
    </div>
}
else
{
    @ChildContent
}
