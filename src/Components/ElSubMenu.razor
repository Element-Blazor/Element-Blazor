@inherits ElMenuContainer
<li role="menuitem" tabindex="@(Disabled || Options.Disabled ? -1 : 0)" aria-haspopup="true"
    class="@SubMenuClass"
    aria-disabled="@(Disabled || Options.Disabled)"
    aria-expanded="@(IsOpened?"true":"")"
    @onkeydown="OnKeyDownAsync">
    <div @onmouseover="OnOverAsync"
         @onmouseout="OnOutAsync"
         @onclick="OnClickAsync"
         @ref="Element"
         class="el-submenu__title"
         title="@EffectiveTitle"
         style="background-color:@backgroundColor;color:@textColor; border-bottom-color:@borderColor;">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <i class="@NormalizeIcon(Icon)" @onmouseover:stopPropagation @onmouseout:stopPropagation></i>
        }
        @if (!EffectiveCollapse)
        {
            <span>@Label</span>
        }
        <i class="el-submenu__icon-arrow el-icon-arrow-down" @onmouseover:stopPropagation @onmouseout:stopPropagation></i>
    </div>
    @if (IsVertical)
    {
        <ul role="menu" class="el-menu el-menu--inline" style="@(IsOpened?"":"display:none;")" data-old-padding-top="" data-old-padding-bottom="" data-old-overflow="" @ref="Container">
            <CascadingValue Value="this">
                @ChildContent
            </CascadingValue>
        </ul>
    }
</li>
