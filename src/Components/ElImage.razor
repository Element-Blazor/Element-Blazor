@inherits ElementComponentBase

<div class="@ImageClass" style="@WrapperStyle" @attributes="Attributes">
    @if (loadFailed)
    {
        <div class="el-image__error">
            @if (ErrorContent != null)
            {
                @ErrorContent
            }
            else
            {
                @ErrorText
            }
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Src))
    {
        <div class="el-image__placeholder">
            @if (Placeholder != null)
            {
                @Placeholder
            }
        </div>
    }
    else
    {
        <img class="el-image__inner" src="@Src" alt="@Alt" loading="@LoadingMode" style="@ImageStyle" @onerror="OnErrorAsync" @onclick="OpenPreviewAsync" />
    }

    @if (ShowViewer)
    {
        <div class="el-image-viewer__wrapper" tabindex="-1">
            <div class="el-image-viewer__mask" @onclick="ClosePreviewAsync"></div>
            <span class="el-image-viewer__btn el-image-viewer__close" @onclick="ClosePreviewAsync">
                <i class="el-icon-circle-close"></i>
            </span>
            @if (PreviewList.Count > 1)
            {
                <span class="el-image-viewer__btn el-image-viewer__prev" @onclick="ShowPreviousAsync">
                    <i class="el-icon-arrow-left"></i>
                </span>
                <span class="el-image-viewer__btn el-image-viewer__next" @onclick="ShowNextAsync">
                    <i class="el-icon-arrow-right"></i>
                </span>
            }
            <div class="el-image-viewer__canvas">
                <img src="@CurrentPreviewSrc" alt="@Alt" />
            </div>
        </div>
    }
</div>
