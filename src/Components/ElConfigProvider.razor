@inherits ElementComponentBase

@if (ShouldRewriteNamespace)
{
    <span @ref="NamespaceRoot" style="display:contents">
        <CascadingValue Value="ResolvedConfig" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </span>
}
else
{
    <CascadingValue Value="ResolvedConfig" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
