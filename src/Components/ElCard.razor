@inherits ElementComponentBase
<div class="@wrapperClassBuilder" style="@Style" @ref="Container">
    @{
        if (Header != null)
        {
            <div class="el-card__header">
                @Header
            </div>
        }
    }

    <div class="@bodyClassBuilder" style="@BodyStyle">
        @Body
    </div>
    @if (Footer != null)
    {
        <div class="el-card__footer">
            @Footer
        </div>
    }
</div>
