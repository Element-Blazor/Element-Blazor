@typeparam TValue

<li class="el-select-group__wrap @(EffectiveDisabled ? "is-disabled" : string.Empty)" role="presentation" aria-disabled="@(EffectiveDisabled ? "true" : "false")">
    <ul class="el-select-group__list">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <li class="el-select-group__title">@Label</li>
        }
        <CascadingValue Value="@this">
            @ChildContent
        </CascadingValue>
    </ul>
</li>
