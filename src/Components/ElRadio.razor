@inherits ElementFieldComponentBase<TValue>
@typeparam TValue
@{
    var checkedValue = IsChecked;
    var isChecked = checkedValue ? "is-checked" : string.Empty;
    var ariaChecked = checkedValue ? "true" : "false";
    var isDisabled = EffectiveDisabled ? "is-disabled" : string.Empty;
    var ariaDisabled = EffectiveDisabled ? "true" : "false";
    var isBordered = IsBordered ? "is-bordered" : string.Empty;
    var effectiveSize = RadioGroup == null
        ? Size != RadioSize.Default
            ? ResolveRadioSize(Size)
            : FormItem?.Form?.EffectiveSize switch
            {
                InputSize.Large => RadioSize.Medium,
                InputSize.Small => RadioSize.Small,
                _ => ResolveRadioSize(Size)
            }
        : RadioGroup.EffectiveSize;
    var size = effectiveSize == RadioSize.Default
        ? string.Empty
        : "el-radio--" + effectiveSize.ToString().ToLowerInvariant();
}
<label role="radio"
       @ref="radioElement"
       tabindex="@TabIndex"
       class="el-radio @isChecked @isDisabled @isBordered @size"
       @onclick="ChangeRadio"
       @onkeydown="OnKeyDownAsync"
       aria-checked="@ariaChecked"
       aria-disabled="@ariaDisabled">
    <span class="el-radio__input @isChecked @isDisabled">
        <span class="el-radio__inner"></span>
        <input type="radio" aria-hidden="true" tabindex="-1" disabled="@EffectiveDisabled" checked="@checkedValue" class="el-radio__original" value="@CurrentSelectedValue">
    </span>
    <span class="el-radio__label">@ChildContent</span>
</label>
