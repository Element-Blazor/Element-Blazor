@inherits ElRadio<TValue>
@typeparam TValue
@{
    var checkedValue = IsChecked;
    var isChecked = checkedValue ? "is-active" : string.Empty;
    var isDisabled = EffectiveDisabled ? "is-disabled" : string.Empty;
    var size = RadioButtonSizeClass;
}
<label role="radio"
       @ref="radioElement"
       tabindex="@TabIndex"
       class="el-radio-button @isChecked @isDisabled @size"
       @onclick="ChangeRadio"
       @onkeydown="OnKeyDownAsync"
       aria-checked="@AriaChecked"
       aria-disabled="@AriaDisabled">
    <input type="radio" aria-hidden="true" tabindex="-1" class="el-radio-button__orig-radio" disabled="@EffectiveDisabled" checked="@checkedValue" name="@EffectiveName" value="@Value">
    <span class="el-radio-button__inner">@ChildContent</span>
</label>
