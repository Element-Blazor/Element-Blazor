@inherits ElementComponentBase
@if (Divided)
{
    <li role="separator" class="el-dropdown-menu__divider"></li>
}
<li role="menuitem"
    tabindex="@(Disabled ? -1 : 0)"
    class="@ItemClass"
    aria-disabled="@Disabled"
    @onclick="InternalOnClickAsync"
    @onkeydown="OnKeyDownAsync"
    @attributes="Attributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <i class="@NormalizeIcon(Icon)"></i>
    }
    @ChildContent
</li>
