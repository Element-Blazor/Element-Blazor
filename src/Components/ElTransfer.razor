@inherits ElementFieldComponentBase<List<string>>
<div class="el-transfer @Cls" style="@Style">
    <div class="el-transfer-panel" targetorder="original">
        <p class="el-transfer-panel__header">
            @if (LeftHeaderContent != null)
            {
                @LeftHeaderContent(LeftPanelContext)
            }
            else
            {
                <ElCheckbox @bind-Status="List1Status" TValue="bool">
                    @LeftTitle
                    <span>@List1Checked.Count/@(List1 == null ? 0 : List1.Count)</span>
                </ElCheckbox>
            }
        </p>
        <div class="el-transfer-panel__body">
            @if (IsFilterable)
            {
                <ElInput Placeholder="@LeftFilterPlaceholder" Value="@list1KeyWords" ValueChanged="List1SearchChanged" PrefixIcon="el-icon-search" Cls="el-transfer-panel__filter" TValue="string"></ElInput>
            }
            @if (!VisibleList1.Any())
            {
                <p class="el-transfer-panel__empty">@GetEmptyText(List1, list1KeyWords)</p>
            }
            else
            {
                <ElCheckboxGroup Cls="@CheckBoxGroupCssBuilder.ToString()" TValue="object">
                    @foreach (var item in VisibleList1)
                    {
                        var itemContent = ResolveItemContent(left: true);
                        <ElCheckbox Status="List1Checked.Contains(item) ? Status.Checked:Status.UnChecked" StatusChanged="status=>Status1Changed(status,item)" IsDisabled="@item.IsDisabled" Cls="el-transfer-panel__item" TValue="TransferItem">
                            @if (itemContent != null)
                            {
                                @itemContent(item)
                            }
                            else
                            {
                                <span>@item.Label</span>
                            }
                        </ElCheckbox>
                    }
                </ElCheckboxGroup>
            }
        </div>
        @if (LeftFooterContent != null)
        {
            <p class="el-transfer-panel__footer">
                @LeftFooterContent(LeftPanelContext)
            </p>
        }
    </div>
    <div class="el-transfer__buttons">
        <ElButton Cls="el-transfer__button" Type="@ButtonType.Primary" OnClick="ToLeft" Icon="el-icon-arrow-left" Disabled="@(!List2Checked.Any())">
            @ToLeftButtonText
        </ElButton>
        <ElButton Cls="el-transfer__button" Type="@ButtonType.Primary" OnClick="ToRight" Icon="el-icon-arrow-right" Disabled="@(!List1Checked.Any())">
            @ToRightButtonText
        </ElButton>
    </div>
    <div class="el-transfer-panel">
        <p class="el-transfer-panel__header">
            @if (RightHeaderContent != null)
            {
                @RightHeaderContent(RightPanelContext)
            }
            else
            {
                <ElCheckbox TValue="bool" @bind-Status="List2Status">
                    @RightTitle
                    <span>@List2Checked.Count/@(List2 == null ? 0 : List2.Count)</span>
                </ElCheckbox>
            }
        </p>
        <div class="el-transfer-panel__body">
            @if (IsFilterable)
            {
                <ElInput Placeholder="@RightFilterPlaceholder" PrefixIcon="el-icon-search" Cls="el-transfer-panel__filter" Value="@list2KeyWords" ValueChanged="List2SearchChanged" TValue="string"></ElInput>
            }
            @if (!VisibleList2.Any())
            {
                <p class="el-transfer-panel__empty">@GetEmptyText(List2, list2KeyWords)</p>
            }
            else
            {
                <ElCheckboxGroup Cls="@CheckBoxGroupCssBuilder.ToString()" TValue="object">
                    @foreach (var item in VisibleList2)
                    {
                        var itemContent = ResolveItemContent(left: false);
                        <ElCheckbox Status="List2Checked.Contains(item) ? Status.Checked:Status.UnChecked" StatusChanged="status=>Status2Changed(status,item)" IsDisabled="@item.IsDisabled" Cls="el-transfer-panel__item" TValue="TransferItem">
                            @if (itemContent != null)
                            {
                                @itemContent(item)
                            }
                            else
                            {
                                <span>@item.Label</span>
                            }
                        </ElCheckbox>
                    }
                </ElCheckboxGroup>
            }
        </div>
        @if (RightFooterContent != null)
        {
            <p class="el-transfer-panel__footer">
                @RightFooterContent(RightPanelContext)
            </p>
        }
    </div>
</div>
