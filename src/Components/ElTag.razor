@inherits ElementComponentBase

@if (isClosed)
{
    return;
}
<span class="@tagCssBuilder.ToString() @FeatureClass" @onclick="OnTagClick" style="@tagStyleBuilder.ToString()" @attributes="Attributes">
    @ChildContent
    @if (Closable)
    {
        <i class="@iconCssBuilder.ToString()" @onclick:stopPropagation="true" @onclick="OnCloseClick"></i>
    }
</span>
