@inherits ElementFieldComponentBase<TValue>
@typeparam TValue
@{
    var backgroundColor = IsActive ? ActiveColor : InactiveColor;
    var showInactiveText = !string.IsNullOrWhiteSpace(InactiveText);
    var showActiveText = !string.IsNullOrWhiteSpace(ActiveText);
    var leftIsActive = string.Empty;
    var rightIsActive = string.Empty;
    if (!IsActive)
    {
        leftIsActive = "is-active";
    }
    else
    {
        rightIsActive = "is-active";
    }

    var styleText = $"border-color: {backgroundColor}; background-color: {backgroundColor};";
    if (EffectiveDisabled)
    {
        styleText = string.Empty;
    }
}
<div role="switch"
     class="@wrapperClsBuilder"
     tabindex="@(EffectiveDisabled ? -1 : 0)"
     aria-checked="@AriaChecked"
     aria-disabled="@AriaDisabled"
     aria-busy="@AriaBusy"
     aria-invalid="@AriaInvalid"
     aria-describedby="@AriaDescribedBy"
     aria-valuetext="@CurrentValueText"
     @onkeydown="OnKeyDownAsync">
    <input id="@InputId"
           @attributes="Attributes"
           type="checkbox"
           name="@Name"
           checked="@IsActive"
           disabled="@EffectiveDisabled"
           true-value="@EffectiveActiveValue"
           false-value="@EffectiveInactiveValue"
           value="@CurrentValueText"
           class="el-switch__input">
    @if (showInactiveText)
    {
        <span class="el-switch__label el-switch__label--left @leftIsActive">
            <span aria-hidden="true">@InactiveText</span>
        </span>
    }
    <span class="el-switch__core" @onclick="OnInternalSwitchChangedAsync" style="width: 40px; @styleText">
        @if (Loading)
        {
            <i class="el-switch__loading @LoadingIcon"></i>
        }
    </span>
    @if (showActiveText)
    {
        <span class="el-switch__label el-switch__label--right @rightIsActive">
            <span aria-hidden="true">@ActiveText</span>
        </span>
    }
</div>
