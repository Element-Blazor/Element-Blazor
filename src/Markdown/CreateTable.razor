@inherits ElementDialogBase
@using Element.Markdown.IconHandlers
<ElForm @ref="form">
    <ElFormItem IsRequired="true" Label="行数" Name="@nameof(CreateTableModel.Rows)" TValue="int">
        <ElInput TValue="int"></ElInput>
    </ElFormItem>
    <ElFormItem IsRequired="true" Label="列数" Name="@nameof(CreateTableModel.Columns)" TValue="int">
        <ElInput TValue="int"></ElInput>
